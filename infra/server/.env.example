# Chép lên server thành /opt/vocab/.env rồi:  chmod 600 /opt/vocab/.env
# File này KHÔNG nằm trong image hay repo. Mất nó thì phải tạo lại và mọi người đăng nhập lại.

# Tên miền, không kèm https://. Caddy dùng nó để xin chứng chỉ.
SITE_ADDRESS=vocab.example.com
# Đúng origin trình duyệt thấy — có https://, không có dấu / cuối.
APP_ORIGIN=https://vocab.example.com

# ghcr.io/<tài khoản GitHub>/<tên repo>, viết thường toàn bộ.
IMAGE_PREFIX=ghcr.io/your-account/your-repo

POSTGRES_USER=vocab
POSTGRES_DB=vocab
# Chỉ dùng chữ và số: giá trị này được ghép thẳng vào DATABASE_URL, ký tự như @ : / sẽ làm hỏng URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

#   openssl rand -hex 48
JWT_SECRET=

# true CHỈ trong lúc tạo tài khoản; xong đặt lại false rồi `docker compose up -d backend`.
REGISTRATION_ENABLED=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

# IMAGE_TAG do workflow deploy tự ghi vào cuối file này — không cần đặt tay.

# --- Backup (backup.sh). Lấy từ `terraform output` — IAM user này chỉ GHI được vào bucket.
BACKUP_BUCKET=
BACKUP_AWS_REGION=ap-southeast-1
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
