// Nguồn sự thật duy nhất của database. Thiết kế đầy đủ: docs/DATABASE.md
// Sửa file này xong → npx prisma migrate dev --name <ten_mo_ta_hanh_dong>
// Kết nối (DATABASE_URL) cấu hình ở prisma7.config.ts, không phải ở đây (thay đổi của Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Language {
  id        String   @id @default(cuid())
  // Chưa có khóa ngoại: bảng User xuất hiện ở Phase 12 (docs/DATABASE.md §5).
  ownerId   String
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelSystems LevelSystem[]
  collections  Collection[]
  vocabularies Vocabulary[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

// LevelSystem, Level, Collection không có cột ownerId: quyền sở hữu đi theo Language.
// Mọi truy vấn phải lọc qua quan hệ, ví dụ `where: { language: { ownerId } }`.
model LevelSystem {
  id         String   @id @default(cuid())
  languageId String
  name       String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  levels   Level[]

  @@index([languageId])
}

model Level {
  id            String   @id @default(cuid())
  levelSystemId String
  name          String
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  levelSystem LevelSystem  @relation(fields: [levelSystemId], references: [id], onDelete: Cascade)
  collections  Collection[]
  vocabularies Vocabulary[]

  @@unique([levelSystemId, name])
  @@index([levelSystemId])
}

enum CollectionKind {
  LESSON
  TOPIC
}

model Collection {
  id          String         @id @default(cuid())
  languageId  String
  // null = collection xuyên level ("Food"). Đây là điểm mấu chốt của ADR-003.
  levelId     String?
  name        String
  kind        CollectionKind @default(LESSON)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  // SetNull: xóa một level không được làm biến mất bài học của nó.
  level    Level?   @relation(fields: [levelId], references: [id], onDelete: SetNull)

  vocabularies VocabularyCollection[]

  @@index([languageId])
  @@index([levelId])
}

// Một bảng cho MỌI ngôn ngữ (ADR-005). Field cần search/filter/sort → cột thật;
// field chỉ để hiển thị và đặc thù ngôn ngữ → `extra`.
model Vocabulary {
  id                 String   @id @default(cuid())
  ownerId            String
  languageId         String
  levelId            String?
  term               String
  meaning            String
  reading            String?
  romanization       String?
  exampleSentence    String?
  exampleTranslation String?
  notes              String?
  extra              Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  language    Language               @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level       Level?                 @relation(fields: [levelId], references: [id], onDelete: SetNull)
  collections VocabularyCollection[]
  // 1-1: mỗi từ có nhiều nhất một dòng tiến độ. Chưa có dòng nào = chưa ôn lần nào = NEW.
  progress    LearningProgress?
  reviewLogs  ReviewLog[]

  @@index([ownerId, languageId])
  // KHÔNG unique: từ đồng tự khác nghĩa là hợp lệ (行 = đi / hàng). Xem DATABASE.md §6.
  @@index([languageId, term])
  @@index([levelId])
}

// Bảng nối tường minh (ADR-004): một từ thuộc nhiều collection mà không phải nhân bản.
model VocabularyCollection {
  vocabularyId String
  collectionId String
  addedAt      DateTime @default(now())

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([vocabularyId, collectionId])
  @@index([collectionId])
}

enum LearningStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum ReviewMode {
  FLASHCARD
  MULTIPLE_CHOICE
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

// Tách khỏi Vocabulary vì là hai loại dữ liệu khác bản chất: Vocabulary là KIẾN THỨC
// (không đổi), LearningProgress là TRẢI NGHIỆM của người học (đổi sau mỗi lần ôn).
model LearningProgress {
  id             String         @id @default(cuid())
  ownerId        String
  // @unique → quan hệ 1-1. Phase 12 đổi thành @@unique([vocabularyId, ownerId]) là thành 1-N.
  vocabularyId   String         @unique
  status         LearningStatus @default(NEW)
  reviewCount    Int            @default(0)
  correctCount   Int            @default(0)
  incorrectCount Int            @default(0)
  // Số lần trả lời đúng liên tiếp — cơ sở chuyển trạng thái ở MVP (ADR-010).
  correctStreak  Int            @default(0)
  lastReviewedAt DateTime?

  // --- Bốn cột dưới đây MVP KHÔNG đọc, KHÔNG ghi (ADR-007). Dành cho thuật toán SRS ở Phase 11. ---
  dueAt        DateTime?
  intervalDays Int       @default(0)
  easeFactor   Float     @default(2.5)
  repetitions  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([ownerId, dueAt])
}

// Một dòng cho MỖI lần trả lời. LearningProgress chỉ giữ tổng tích lũy, từ đó không thể
// biết "hôm nay đúng bao nhiêu câu" — Dashboard cần bảng này.
model ReviewLog {
  id           String        @id @default(cuid())
  ownerId      String
  vocabularyId String
  mode         ReviewMode
  rating       ReviewRating?
  // Luôn có giá trị; với flashcard được suy ra từ rating (ADR-010).
  isCorrect    Boolean
  reviewedAt   DateTime      @default(now())

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([ownerId, reviewedAt])
  @@index([vocabularyId])
}
